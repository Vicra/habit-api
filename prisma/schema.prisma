// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Habit {
  id          String       @id @default(uuid()) @map("_id")
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt
  startDate   DateTime
  userHabits  UserHabits[]
  userId      String
  user        User         @relation(fields: [userId], references: [id])
}

model User {
  id            String       @id @default(uuid()) @map("_id")
  name          String
  email         String       @unique
  password      String
  salt          String // password encryption
  createdAt     DateTime     @default(now())
  updatedAt     DateTime?    @updatedAt
  createdHabits Habit[]
  userHabits    UserHabits[] @relation("userHabits")
  createdBy     UserHabits[] @relation("createdBy")
}

model UserHabits {
  id     String @id @default(uuid()) @map("_id")
  user   User   @relation(fields: [userId], references: [id], name: "userHabits")
  userId String

  habit   Habit  @relation(fields: [habitId], references: [id])
  habitId String

  createdBy   User   @relation(fields: [createdById], references: [id], name: "createdBy")
  createdById String
}
